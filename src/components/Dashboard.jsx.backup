[729]                     </h1>
[730]                     <p className="text-slate-500 text-sm mt-1 font-medium flex items-center gap-2">
[731]                       martes, 28 de julio <span className="text-slate-300">•</span> Última sincronización: 7:34 PM
[732]                     </p>
[733]                   </div>
[734]                   <div className="flex items-center gap-3 text-[10px] font-bold tracking-widest text-slate-500 bg-white px-4 py-2.5 rounded-full border border-gray-200 shadow-sm uppercase">
[735]                     <span>sv <span className="text-slate-900">7:34 PM CST</span></span>
[736]                     <span className="text-gray-300">|</span>
[737]                     <span>us <span className="text-slate-900">6:34 PM PDT</span></span>
[738]                   </div>
[739]                 </div>
[740] 
[741]                 {/* KPI Cards */}
[742]                 <div className="grid grid-cols-4 gap-5 lg:gap-6">
[743]                   {/* KPI 1 */}
[744]                   <div className="bg-white rounded-[20px] p-6 lg:p-8 border border-gray-100/80 shadow-[0_4px_24px_rgba(0,0,0,0.09)] flex items-center gap-4 hover:shadow-[0_8px_32px_rgba(0,0,0,0.13)] transition-shadow">
[745]                     <div className="w-[44px] h-[44px] rounded-full bg-[#0B1B2C] flex items-center justify-center flex-shrink-0">
[746]                       <Building2 size={18} className="text-[#C5A059]" />
[747]                     </div>
[748]                     <div>
