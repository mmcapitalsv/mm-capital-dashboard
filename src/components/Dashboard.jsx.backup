[723]               {/* Header & KPIs */}
[724]               <div className="px-8 mt-8 mb-8">
[725]                 <div className="flex justify-between items-end mb-8">
[726]                   <div>
[727]                     <h1 className="text-[32px] lg:text-4xl font-bold text-slate-900 tracking-tight leading-tight">
