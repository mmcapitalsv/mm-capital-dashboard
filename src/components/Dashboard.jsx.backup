[770]                   <div className="bg-white rounded-[20px] p-6 lg:p-8 border border-gray-100/80 shadow-[0_4px_24px_rgba(0,0,0,0.09)] flex items-center gap-4 hover:shadow-[0_8px_32px_rgba(0,0,0,0.13)] transition-shadow">
[771]                     <div className="w-[44px] h-[44px] rounded-full bg-[#0B1B2C] flex items-center justify-center flex-shrink-0">
[772]                       <TrendingUp size={18} className="text-[#C5A059]" />
