[763]                       <p className="text-2xl lg:text-[28px] font-bold text-slate-900 mb-0.5 leading-none">$14.8M</p>
[764]                       <p className="text-emerald-500 text-[10px] font-bold flex items-center gap-1 mt-1.5">
[765]                         <ArrowUp size={10} /> 8.6% <span className="text-slate-400 font-medium">vs. mes anterior</span>
[766]                       </p>
