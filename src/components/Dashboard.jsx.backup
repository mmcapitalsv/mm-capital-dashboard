[793]                     >
[794]                       <Settings size={20} />
[795]                     </button>
[796]                     {showSettings && (
[797]                       <div className="absolute top-10 right-0 w-56 bg-white rounded-xl shadow-xl border border-gray-100 z-50 overflow-hidden">
[798]                         <div className="py-2">
[799]                           <button className="w-full px-4 py-2.5 text-left text-[11px] font-semibold text-slate-700 hover:bg-gray-50 hover:text-mm-gold transition-colors flex items-center gap-2">
[800]                             <Users size={14} className="text-slate-400"/> Gestión de Accesos (Socios)
[801]                           </button>
[802]                           <button className="w-full px-4 py-2.5 text-left text-[11px] font-semibold text-slate-700 hover:bg-gray-50 hover:text-mm-gold transition-colors flex items-center gap-2">
[803]                             <Settings size={14} className="text-slate-400"/> Preferencias del Sistema
[804]                           </button>
[805]                           <div className="h-px bg-gray-100 my-1"></div>
[806]                           <button className="w-full px-4 py-2.5 text-left text-[11px] font-semibold text-slate-700 hover:bg-gray-50 hover:text-mm-gold transition-colors flex items-center gap-2">
[807]                             <FileText size={14} className="text-slate-400"/> Exportar Reporte Global (PDF)
[808]                           </button>
[809]                         </div>
[810]                       </div>
[811]                     )}
[812]                   </div>
[813] 
[814]                   <button onClick={onLogout} className="flex items-center gap-2 hover:bg-gray-50 px-2 py-1 rounded-lg transition-colors ml-2">
[815]                     <div className="w-11 h-11 bg-[#0B1B2C] rounded-full flex items-center justify-center border border-gray-200 shadow-sm">
[816]                       <span className="text-[13px] font-bold text-white tracking-widest">LP</span>
[817]                     </div>
[818]                     <ChevronDown size={14} className="text-slate-400" />
[819]                   </button>
[820]                 </div>
[821]               </div>
[822] 
[823]               {/* Header & KPIs */}
[824]               <div className="px-8 mt-8 mb-8">
[825]                 <div className="flex justify-between items-end mb-8">
[826]                   <div>
[827]                     <h1 className="text-[32px] lg:text-4xl font-bold text-slate-900 tracking-tight leading-tight">
[828]                       Buenas noches, <span className="text-[#C5A059]">Ing. Luis Panameño</span>
[829]                     </h1>
[830]                     <p className="text-slate-500 text-sm mt-1 font-medium flex items-center gap-2">
[831]                       martes, 28 de julio <span className="text-slate-300">•</span> Última sincronización: 7:34 PM
[832]                     </p>
[833]                   </div>
[834]                   <div className="flex items-center gap-3 text-[10px] font-bold tracking-widest text-slate-500 bg-white px-4 py-2.5 rounded-full border border-gray-200 shadow-sm uppercase">
[835]                     <span>sv <span className="text-slate-900">7:34 PM CST</span></span>
[836]                     <span className="text-gray-300">|</span>
[837]                     <span>us <span className="text-slate-900">6:34 PM PDT</span></span>
[838]                   </div>
[839]                 </div>
[840] 
[841]                 {/* KPI Cards */}
[842]                 <div className="grid grid-cols-4 gap-5 lg:gap-6">
[843]                   {/* KPI 1 */}
[844]                   <div className="bg-white rounded-[20px] p-6 lg:p-8 border border-gray-100/80 shadow-[0_4px_24px_rgba(0,0,0,0.09)] flex items-center gap-4 hover:shadow-[0_8px_32px_rgba(0,0,0,0.13)] transition-shadow">
[845]                     <div className="w-[44px] h-[44px] rounded-full bg-[#0B1B2C] flex items-center justify-center flex-shrink-0">
[846]                       <Building2 size={18} className="text-[#C5A059]" />
[847]                     </div>
[848]                     <div>
[849]                       <p className="text-[10px] text-slate-400 font-bold tracking-widest uppercase mb-1">Proyectos Activos</p>
[850]                       <p className="text-2xl lg:text-[28px] font-bold text-slate-900 mb-0.5 leading-none">3</p>
[851]                       <p className="text-emerald-500 text-[10px] font-bold flex items-center gap-1 mt-1.5">
[852]                         <ArrowUp size={10} /> +2 <span className="text-slate-400 font-medium">vs. mes anterior</span>
[853]                       </p>
[854]                     </div>
[855]                   </div>
[856]                   {/* KPI 2 */}
[857]                   <div className="bg-white rounded-[20px] p-6 lg:p-8 border border-gray-100/80 shadow-[0_4px_24px_rgba(0,0,0,0.09)] flex items-center gap-4 hover:shadow-[0_8px_32px_rgba(0,0,0,0.13)] transition-shadow">
[858]                     <div className="w-[44px] h-[44px] rounded-full bg-[#0B1B2C] flex items-center justify-center flex-shrink-0">
[859]                       <DollarSign size={18} className="text-[#C5A059]" />
[860]                     </div>
[861]                     <div>
[862]                       <p className="text-[10px] text-slate-400 font-bold tracking-widest uppercase mb-1">Capital Invertido</p>
[863]                       <p className="text-2xl lg:text-[28px] font-bold text-slate-900 mb-0.5 leading-none">$14.8M</p>
[864]                       <p className="text-emerald-500 text-[10px] font-bold flex items-center gap-1 mt-1.5">
[865]                         <ArrowUp size={10} /> 8.6% <span className="text-slate-400 font-medium">vs. mes anterior</span>
[866]                       </p>
[867]                     </div>
[868]                   </div>
[869]                   {/* KPI 3 */}
[870]                   <div className="bg-white rounded-[20px] p-6 lg:p-8 border border-gray-100/80 shadow-[0_4px_24px_rgba(0,0,0,0.09)] flex items-center gap-4 hover:shadow-[0_8px_32px_rgba(0,0,0,0.13)] transition-shadow">
[871]                     <div className="w-[44px] h-[44px] rounded-full bg-[#0B1B2C] flex items-center justify-center flex-shrink-0">
[872]                       <TrendingUp size={18} className="text-[#C5A059]" />
[873]                     </div>
[874]                     <div>
[875]                       <p className="text-[10px] text-slate-400 font-bold tracking-widest uppercase mb-1">Avance Promedio</p>
[876]                       <p className="text-2xl lg:text-[28px] font-bold text-slate-900 mb-0.5 leading-none">62%</p>
[877]                       <p className="text-emerald-500 text-[10px] font-bold flex items-center gap-1 mt-1.5">
[878]                         <ArrowUp size={10} /> 5% <span className="text-slate-400 font-medium">vs. mes anterior</span>
[879]                       </p>
[880]                     </div>
[881]                   </div>
[882]                   {/* KPI 4 */}
[883]                   <div className="bg-white rounded-[20px] p-6 lg:p-8 border border-gray-100/80 shadow-[0_4px_24px_rgba(0,0,0,0.09)] flex items-center gap-4 hover:shadow-[0_8px_32px_rgba(0,0,0,0.13)] transition-shadow">
[884]                     <div className="w-[44px] h-[44px] rounded-full bg-[#0B1B2C] flex items-center justify-center flex-shrink-0">
[885]                       <Wallet size={18} className="text-[#C5A059]" />
[886]                     </div>
[887]                     <div>
[888]                       <p className="text-[10px] text-slate-400 font-bold tracking-widest uppercase mb-1">Flujo del Mes</p>
[889]                       <p className="text-2xl lg:text-[28px] font-bold text-slate-900 mb-0.5 leading-none">$245,000</p>
[890]                       <p className="text-red-500 text-[10px] font-bold flex items-center gap-1 mt-1.5">
[891]                         ↓ 12% <span className="text-slate-400 font-medium">vs. mes anterior</span>
[892]                       </p>
[893]                     </div>
[894]                   </div>
[895]                 </div>
[896]               </div>
[897]               {/* --- DESKTOP CENTRAL LAYOUT (2 COLUMNS) --- */}
[898]               <div className="px-8 grid grid-cols-[1.2fr_1fr] lg:grid-cols-[1.5fr_1fr] gap-7 mb-7">
[899]                 
[900]                 {/* Proyecto Destacado — CAROUSEL */}
[901]                 {(() => {
[902]                   if (!PROJECTS || PROJECTS.length === 0) return <div className="p-6 text-slate-500 text-sm">Cargando proyecto destacado...</div>;
[903]                     : 'bg-blue-50 text-blue-600 border-blue-100';
[904]                   return (
[905]                     <div className="bg-white rounded-[20px] shadow-[0_1px_8px_rgba(0,0,0,0.05)] border border-gray-100/80 flex flex-col p-5 lg:p-6">
[906]                       
[907]                       {/* Header con flechas */}
[908]                       <div className="flex justify-between items-center mb-5">
[909]                         <div className="flex items-center gap-2">
[910]                           <Building2 size={16} className="text-[#C5A059]" />
[911]                           <h2 className="text-[11px] font-bold text-slate-900 tracking-[0.12em] uppercase">Proyectos Registrados</h2>
[912]                         </div>
[913]                         {/* Nav flechas + indicador */}
[914]                         <div className="flex items-center gap-2">
[915]                           <span className="text-[10px] text-slate-400 font-medium mr-2">
[916]                             {featuredIndex + 1} de {PROJECTS.length}
[917]                           </span>
[918]                           <button
[919]                             onClick={() => setFeaturedIndex((featuredIndex - 1 + PROJECTS.length) % PROJECTS.length)}
[920]                             className="w-7 h-7 rounded-full border border-gray-200 flex items-center justify-center text-slate-500 hover:bg-gray-50 hover:border-gray-300 hover:text-slate-800 transition-all active:scale-95"
[921]                           >
[922]                             <ChevronLeft size={14} />
[923]                           </button>
[924]                           <button
[925]                             onClick={() => setFeaturedIndex((featuredIndex + 1) % PROJECTS.length)}
[926]                             className="w-7 h-7 rounded-full border border-gray-200 flex items-center justify-center text-slate-500 hover:bg-gray-50 hover:border-gray-300 hover:text-slate-800 transition-all active:scale-95"
[927]                           >
[928]                             <ChevronRight size={14} />
[929]                           </button>
[930]                         </div>
[931]                       </div>
[932] 
[933]                       {/* Imagen + Texto lado a lado */}
[934]                       <div className="flex gap-5 lg:gap-6 mb-4 lg:mb-5">
[935]                         {/* Imagen */}
[936]                         <div onClick={() => handleCardClick(fp)} className="w-[45%] rounded-2xl overflow-hidden shadow-sm flex-shrink-0 relative group cursor-pointer h-[160px] lg:h-[200px]">
[937]                           <img src={fp.img} alt={fp.name} className={`w-full h-full object-cover transition-all duration-500 ${isEditMode ? 'opacity-80' : 'group-hover:scale-105'}`} />
[938]                           {isEditMode && (
[939]                             <div className="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
[940]                               <div className="bg-white/90 p-2 rounded-full shadow-lg text-slate-900">
[941]                                 <Camera size={20} />
[942]                               </div>
[943]                             </div>
[944]                           )}
[945]                         </div>
[946] 
[947]                         {/* Texto */}
[948]                         <div className="flex-1 flex flex-col justify-between py-1">
[949]                           <div>
[950]                             <div className={`px-2.5 py-1 rounded-md text-[9px] lg:text-[10px] font-bold tracking-wider inline-flex mb-2 lg:mb-3 uppercase border ${statusColor}`}>
[951]                               {fp.status}
[952]                             </div>
[953]                             <h3 onClick={() => handleCardClick(fp)} className={`text-lg lg:text-xl font-bold text-slate-900 mb-1 tracking-tight relative group cursor-pointer ${isEditMode ? 'hover:bg-slate-50 rounded px-1 -ml-1' : 'hover:text-[#C5A059]'}`}>
[954]                               {fp.name}
[955]                               {isEditMode && <Edit2 size={14} className="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 opacity-0 group-hover:opacity-100" />}
[956]                             </h3>
[957]                             <p className="text-[13px] lg:text-sm text-slate-500 font-medium flex items-center gap-1.5 mb-1.5 lg:mb-2">
[958]                               <MapPin size={13} className="text-slate-400"/> {fp.location}
[959]                             </p>
[960]                             <p className={`text-[11px] lg:text-xs text-slate-500 leading-relaxed relative group ${isEditMode ? 'cursor-pointer hover:bg-slate-50 rounded px-1 -ml-1' : ''}`}>
[961]                               {fp.description}
[962]                               {isEditMode && <Edit2 size={12} className="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 opacity-0 group-hover:opacity-100" />}
[963]                             </p>
[964]                           </div>
[965] 
[966]                           {/* Progress bar */}
[967]                           <div className="mt-3">
[968]                             <div className="flex justify-between items-center mb-1.5">
[969]                               <span className="text-[11px] font-bold text-slate-600">Avance del proyecto</span>
[970]                               <span className="text-[15px] font-bold text-slate-900 leading-none">{fp.progress}%</span>
[971]                             </div>
[972]                             <div className="w-full bg-slate-100 rounded-full h-1.5">
[973]                               <div className="bg-[#D9AC6B] rounded-full h-1.5 transition-all duration-500" style={{width: `${fp.progress}%`}}></div>
[974]                             </div>
[975]                           </div>
[976]                         </div>
[977]                       </div>
[978] 
[979]                       {/* Stats Row */}
[980]                       <div className="border-t border-gray-100 pt-3 lg:pt-4 grid grid-cols-4 gap-2 lg:gap-4">
[981]                         <div className={`flex flex-col relative group ${isEditMode ? 'cursor-pointer hover:bg-slate-50 rounded p-1 -m-1' : ''}`}>
[982]                           <p className="text-[8px] lg:text-[9px] text-slate-400 font-bold uppercase tracking-widest mb-1 lg:mb-1.5 leading-tight">Presupuesto<br/>Total</p>
[983]                           <p className="text-[15px] lg:text-[17px] font-bold text-slate-900 leading-none">{fp.presupuesto}</p>
[984]                           {isEditMode && <Edit2 size={12} className="absolute right-1 top-1 text-slate-400 opacity-0 group-hover:opacity-100" />}
[985]                         </div>
[986]                         <div className="flex flex-col border-l border-gray-100 pl-2 lg:pl-4">
[987]                           <p className="text-[8px] lg:text-[9px] text-slate-400 font-bold uppercase tracking-widest mb-1 lg:mb-1.5 leading-tight">Ejecutado</p>
[988]                           <p className="text-[15px] lg:text-[17px] font-bold text-slate-900 leading-none">{fp.ejecutado}</p>
[989]                           <p className="text-[10px] lg:text-[11px] font-bold text-[#C5A059] mt-1">{fp.ejecutadoPct}</p>
[990]                         </div>
[991]                         <div className="flex flex-col border-l border-gray-100 pl-2 lg:pl-4">
[992]                           <p className="text-[8px] lg:text-[9px] text-slate-400 font-bold uppercase tracking-widest mb-1 lg:mb-1.5 leading-tight">Entrega<br/>Estimada</p>
[993]                           <p className="text-[12px] lg:text-[14px] font-bold text-slate-900 leading-none pt-0.5">{fp.entrega}</p>
[994]                         </div>
[995]                         <div className="flex flex-col border-l border-gray-100 pl-2 lg:pl-4">
[996]                           <p className="text-[8px] lg:text-[9px] text-slate-400 font-bold uppercase tracking-widest mb-1 lg:mb-1.5 leading-tight">Rentabilidad<br/>Proyectada</p>
[997]                           <p className="text-[15px] lg:text-[17px] font-bold text-emerald-500 leading-none">{fp.rentabilidad}</p>
[998]                         </div>
[999]                       </div>
[1000] 
[1001]                       {/* Footer Actions */}
[1002]                       <div className="border-t border-gray-100 pt-3 lg:pt-4 mt-3 lg:mt-4 grid grid-cols-2 gap-4">
[1003]                         <button 
[1004]                           onClick={() => handleCardClick(fp)}
[1005]                           className="bg-[#0B1B2C] text-white py-2.5 rounded-xl text-[12px] font-bold flex items-center justify-center gap-1 w-full hover:bg-slate-800 transition-colors shadow-sm"
[1006]                         >
[1007]                           Ir al Proyecto <ChevronRight size={14}/>
[1008]                         </button>
[1009]                         <button 
[1010]                           onClick={() => setCurrentView('all-projects')}
[1011]                           className="bg-white text-slate-700 border border-gray-200 py-2.5 rounded-xl text-[12px] font-bold flex items-center justify-center gap-1.5 w-full hover:bg-gray-50 transition-colors shadow-sm"
[1012]                         >
[1013]                           <Layers size={14} className="text-slate-400" />
[1014]                           Ver Todos los Proyectos
[1015]                         </button>
[1016]                       </div>
[1017]                     </div>
[1018]                   );
[1019]                 })()}
[1020] 
[1021]                 {/* Gráfica Flujo de Caja */}
[1022]                 <div className="bg-white rounded-[20px] shadow-[0_1px_8px_rgba(0,0,0,0.05)] border border-gray-100/80 flex flex-col p-5 lg:p-6">
[1023]                   <div className="flex justify-between items-center mb-4 lg:mb-5">
[1024]                     <h2 className="text-[11px] font-bold text-slate-900 tracking-[0.12em] uppercase">Flujo de caja (mensual)</h2>
[1025]                     <button className="flex items-center gap-1 text-[11px] font-semibold text-slate-600 bg-white px-2.5 py-1.5 border border-gray-200 rounded-lg shadow-sm hover:bg-gray-50 transition-colors">
[1026]                       Este año <ChevronDown size={12} className="text-slate-400" />
[1027]                     </button>